{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    // NodeNext to match how Vercel typechecks functions. Under "bundler" the
    // extensionless import below compiled locally and then failed the deploy
    // with TS2835 — the local build must reproduce the deploy build.
    "module": "NodeNext",
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "src/lib/muscleVolume.ts"]
}
